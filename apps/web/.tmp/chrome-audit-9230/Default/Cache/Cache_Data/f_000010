async function decoratePlaces(rows, userId) {
	if (!supabase || rows.length === 0) {
		return rows.map((r) => rowToPlace(r));
	}
	const ids = rows.map((r) => r.id);
	// Contagem de seguidores por local
	const counts = new Map();
	const { data: followerRows, error: fErr } = await supabase.from(TABLE_FOLLOWERS).select("place_id,user_id").in("place_id", ids);
	if (fErr) throw new Error(fErr.message);
	const myFollows = new Set();
	for (const row of followerRows ?? []) {
		counts.set(row.place_id, (counts.get(row.place_id) ?? 0) + 1);
		if (row.user_id === userId) myFollows.add(row.place_id);
	}
	return rows.map((r) => rowToPlace(r, counts.get(r.id) ?? 0, myFollows.has(r.id)));
}
export async function listAllPlaces(user) {
	if (!supabase) return [];
	const { data, error } = await supabase.from(TABLE_PLACES).select(PLACE_SELECT_FIELDS).order("name", { ascending: true });
	if (error) throw new Error(error.message);
	return decoratePlaces(data ?? [], user.id);
}
export async function getPlaceById(user, placeId) {
	if (!supabase) return null;
	const { data, error } = await supabase.from(TABLE_PLACES).select(PLACE_SELECT_FIELDS).eq("id", placeId).maybeSingle();
	if (error) throw new Error(error.message);
	if (!data) return null;
	const [place] = await decoratePlaces([data], user.id);
	return place || null;
}
