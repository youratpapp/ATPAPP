export async function listPlaceAcademyEnrollments(placeId) {
	if (!supabase) return [];
	const rows = [];
	let from = 0;
	while (true) {
		const to = from + ADMIN_RESOURCE_PAGE_SIZE - 1;
		const { data, error } = await supabase.from(TABLE_ACADEMY_ENROLLMENTS).select(ACADEMY_ENROLLMENT_SELECT).eq("place_id", placeId).neq("status", "cancelled").order("created_at", { ascending: false }).range(from, to);
		if (error) throw new Error(error.message);
		const page = data ?? [];
		rows.push(...page);
		if (page.length < ADMIN_RESOURCE_PAGE_SIZE) break;
		from += ADMIN_RESOURCE_PAGE_SIZE;
	}
	return rows.map(rowToAcademyEnrollment);
}
