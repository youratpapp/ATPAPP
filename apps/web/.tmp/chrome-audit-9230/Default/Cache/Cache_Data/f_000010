export async function listPlacesIAccess(user) {
	if (!supabase) return [];
	await claimPlaceStaffInvites().catch(() => 0);
	const [owned, staffRows] = await Promise.all([listPlacesIOwn(user), supabase.from(TABLE_PLACE_STAFF).select("place_id").eq("user_id", user.id)]);
	if (staffRows.error) throw new Error(staffRows.error.message);
	const ownedIds = new Set(owned.map((place) => place.id));
	const staffPlaceIds = (staffRows.data ?? []).map((row) => row.place_id).filter((id) => !ownedIds.has(id));
	if (!staffPlaceIds.length) return owned;
