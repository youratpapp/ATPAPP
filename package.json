{
  "name": "tenis-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @tenis/web",
    "build:web": "npm run build -w @tenis/web",
    "preview:web": "npm run preview -w @tenis/web",
    "typecheck": "npm run typecheck -w @tenis/shared && npm run build -w @tenis/web",
    "bootstrap": "npm install"
  }
}
